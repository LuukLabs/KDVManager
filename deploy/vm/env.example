# Copy to /opt/kdvmanager/.env on the VM and fill in. Keep it chmod 600.
# Never commit the real file.

# --- TLS -------------------------------------------------------------------
# manual: use certs/tls.crt + certs/tls.key (testing before DNS points here)
# auto:   Caddy obtains/renews Let's Encrypt certs (after DNS cutover)
TLS_MODE=manual
ACME_EMAIL=admin@luuklabs.com

# --- Image tags (keep in sync with deploy/k8s/applications/*/kustomization.yaml)
WEB_TAG=linux-a3f57d0
CRM_TAG=linux-e8f60cb
SCHEDULING_TAG=linux-a3f57d0

# --- Managed Postgres (private VPC hostname) --------------------------------
POSTGRES_HOST=private-db-kdvmanager-ams3-do-user-13194146-0.l.db.ondigitalocean.com
POSTGRES_PORT=25060
POSTGRES_USER=kdvmanager_vm
POSTGRES_PASSWORD=
# While testing, point at the *_staging copies (scripts/copy-staging-db.sh).
# At cutover, switch to KDVManagerCRMDB / KDVManagerSchedulingDB.
CRM_DATABASE=KDVManagerCRMDB_staging
SCHEDULING_DATABASE=KDVManagerSchedulingDB_staging

# --- RabbitMQ (internal only) -----------------------------------------------
RABBITMQ_USER=kdvmanager
# generate with: openssl rand -hex 32
RABBITMQ_PASS=
