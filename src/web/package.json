    "react-router-dom": "7.18.6",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "api:generate": "orval --clean",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "knip": "knip",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "translations:extract": "i18next -c ./i18next-parser.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset": "orval --clean && eslint --fix ./src/api && prettier --write .",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=dot --reporter=github-actions --coverage"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.2",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "~10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "i18next-parser": "^9.4.0",
    "jiti": "^2.7.0",
    "knip": "^6.46.0",
    "orval": "8.48.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.3.0"
